# Copy to server/.env. Nothing here is required to boot — AdsPilot starts with a local JSON store and tells you in the UI what is missing.

# 4000 is LocalWP, DevPilot runs on 4001 on the box, SEOPilot on 4010. AdsPilot is 4020.
PORT=4020

# Where the app is reachable from outside. Builds the Google OAuth redirect URI, which must match the one registered in Google Cloud EXACTLY.
AP_APP_URL=https://ads.pilotworks4u.com

# Proves that whoever creates the FIRST account (who runs the install) is the person who deployed it. Set it on any public URL.
AP_SETUP_KEY=

# "open" lets anyone create their own workspace. Anything else: only the first account, then the owner adds people from Team.
AP_SIGNUP=

# Encrypts stored Google tokens and the developer token. Set it, and KEEP A COPY OFF THE BOX: SEOPilot lost every Google connection when
# its box died with the key on it (2026-08-13). Blank = a key file is generated beside the database.
AP_MASTER_KEY=

# Where db.json lives. Default: server/data.
AP_DATA_DIR=

# Google Cloud OAuth client (Web application) with the Google Ads API enabled. Can also be set in Admin.
#   Authorised redirect URI:  <AP_APP_URL>/oauth/google/callback
AP_GOOGLE_CLIENT_ID=
AP_GOOGLE_CLIENT_SECRET=

# Google Ads API: the developer token from the API Center of the platform's manager account, and the API version (e.g. v22).
# Can also be set in Admin. A token at Test access only works on test accounts.
AP_GADS_DEVELOPER_TOKEN=
AP_GADS_API_VERSION=

# The AI engine for ad copy and questions: cli (Claude Code on the box), api, codex, gemini, auto. Same choices as SEOPilot.
AP_AI_ENGINE=
AP_AI_API_KEY=
# AI runs per workspace per rolling 24 hours (the platform admin is exempt). 0 or "off" removes it.
AP_AI_DAILY_LIMIT=30

# Email for alerts. Off unless set; the Alerts screen says so. Same providers as SEOPilot (Resend: AP_MAIL_ENGINE=resend).
AP_MAIL_ENGINE=
AP_MAIL_API_KEY=
AP_MAIL_FROM=

# Shown on /api/health so a deploy can be confirmed. deploy.sh sets it.
AP_COMMIT=
